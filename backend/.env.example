# Server Configuration
PORT=4000
NODE_ENV=development
HOTEL_TIMEZONE=Europe/Nicosia
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oscar_dog_hotel

# Shared Account Authentication
JWT_SECRET=oscar_dog_hotel_jwt_secret_change_me_in_production_key_2026!
JWT_REFRESH_SECRET=oscar_dog_hotel_jwt_refresh_secret_change_me_in_prod_2026!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google Drive Backups
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_KEY=oscar_hotel_backup_aes256_secret_key_32_bytes!
